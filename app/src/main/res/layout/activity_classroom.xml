<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@android:color/white">

    <WebView android:id="@+id/board"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <!-- Bhumika digital library / any web page, captured onto the board for annotation -->
    <LinearLayout android:id="@+id/libraryPanel"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:background="@android:color/white"
        android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingHorizontal="8dp" android:background="@color/brand_primary">
            <com.google.android.material.button.MaterialButton android:id="@+id/libBack"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@android:color/white" android:text="‹ Board" />
            <TextView android:id="@+id/libTitle"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="@android:color/white" android:textSize="16sp"
                android:maxLines="1" android:ellipsize="end" android:paddingHorizontal="8dp"
                android:text="Digital Library" />
            <com.google.android.material.button.MaterialButton android:id="@+id/libCapture"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:backgroundTint="@color/brand_accent" android:textColor="#111827"
                android:text="✎ Write on this page" />
        </LinearLayout>
        <WebView android:id="@+id/libWeb"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
